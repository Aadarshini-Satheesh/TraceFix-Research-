# ─── TraceFix Research – Backend Environment Variables ────────────────────────
# Copy this to .env for local development overrides.
# In production (Render): set these in the Render dashboard → Environment tab.
#
# ── Storage ────────────────────────────────────────────────────────────────
# DATA_ROOT: override default storage root (auto-detected per platform otherwise)
# DATA_ROOT=/app/data

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or "*" for all.
# Set this to your Netlify URL after deployment.
ALLOWED_ORIGINS=*

# ── AI Providers ───────────────────────────────────────────────────────────
DEFAULT_PROVIDER=mock
# DEFAULT_PROVIDER=gemini

# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Custom/Local LLM (e.g., Ollama) ────────────────────────────────────────
# CUSTOM_API_BASE=http://localhost:11434/v1
# CUSTOM_API_KEY=ollama
# DEFAULT_MODEL=llama3

# ── Debug ──────────────────────────────────────────────────────────────────
DEBUG=true
