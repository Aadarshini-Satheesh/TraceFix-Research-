# ─── TraceFix Research – Frontend Environment Variables ───────────────────────
#
# Copy this file to .env.local for local development overrides.
# In Netlify: add these in Site settings → Environment variables.
#
# VITE_API_URL
#   The root URL of your deployed FastAPI backend (no trailing slash).
#   Leave blank (or omit) for local dev — the Vite proxy handles /api → localhost:8000.
#
# Example (Render.com deployment):
# VITE_API_URL=https://tracefix-api.onrender.com
#
# Example (Railway deployment):
# VITE_API_URL=https://tracefix-api.up.railway.app

VITE_API_URL=
