*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
env/
ENV/
.venv/

# Environment files – NEVER commit secrets
.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# SQLite databases (they live on persistent disk in production)
*.db
*.sqlite
*.sqlite3

# Project cache and sandbox runs
.cache/
sandbox_runs/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite / Frontend build output
frontend/dist/
frontend/.vite/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Uploaded repositories (stored on persistent disk in production)
backend/data/repositories/
